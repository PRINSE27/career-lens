generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes    Resume[]
  analyses   ResumeAnalysis[]
  jobMatches JobMatch[]
}

model Resume {
  id            Int      @id @default(autoincrement())
  fileName      String
  filePath      String
  fileSize      Int
  extractedText String?
  uploadedAt    DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  analysis   ResumeAnalysis?
  jobMatches JobMatch[]
}

model ResumeAnalysis {
  id       Int @id @default(autoincrement())
  resumeId Int @unique
  userId   Int

  // ============================================================
  // EXTRACTED RESUME INFORMATION
  // ============================================================

  personalInfo        Json?
  professionalSummary String?

  skills         Json?
  education      Json?
  experience     Json?
  projects       Json?
  certifications Json?
  achievements   Json?
  softSkills     Json?
  keywords       Json?

  // ============================================================
  // AI ANALYSIS
  // ============================================================

  score           Int?
  summary         String?
  strengths       Json?
  weaknesses      Json?
  skillGaps       Json?
  recommendations Json?

  atsAnalysis       Json?
  careerSuggestions Json?

  // ============================================================
  // TIMESTAMPS
  // ============================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ============================================================
  // RELATIONS
  // ============================================================

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id Int @id @default(autoincrement())

  // ============================================================
  // JOB INFORMATION
  // ============================================================

  externalId String?
  source     String

  title       String
  company     String
  location    String?
  remote      Boolean @default(false)

  url         String
  description String

  employmentType String?
  postedAt      DateTime?
  expiresAt     DateTime?

  requirements Json?
  skills       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches JobMatch[]

  @@unique([source, externalId])
}

model JobMatch {
  id       Int @id @default(autoincrement())
  userId   Int
  resumeId Int
  jobId    Int

  // ============================================================
  // AI MATCHING
  // ============================================================

  matchScore Int

  matchingSkills Json?
  missingSkills  Json?

  explanation String?

  recommendations Json?

  // ============================================================
  // TIMESTAMPS
  // ============================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ============================================================
  // RELATIONS
  // ============================================================

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, resumeId, jobId])

  @@index([userId])
  @@index([resumeId])
  @@index([jobId])
  @@index([matchScore])
}